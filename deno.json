{
  "name": "@hmalinchock/pipeline-dashboard",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./app.tsx",
    "./init": "./init.ts"
  },
  "publish": {
    "include": [
      "app.tsx",
      "init.ts",
      "types.ts",
      "store.ts",
      "providers/**",
      "ui/**",
      "README.md",
      "LICENSE",
      "deno.json"
    ]
  },
  "tasks": {
    "demo": "deno run --allow-net --watch testdata/demo.tsx",
    "dev": "deno run --allow-net --watch testdata/demo.tsx",
    "test": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net",
    "check": "deno check app.tsx init.ts store.ts providers/gitlab.ts providers/github.ts providers/fixture.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.22",
    "@std/path": "jsr:@std/path@^1.1.6",
    "preact": "npm:preact@10.26.4",
    "preact/": "npm:/preact@10.26.4/",
    "preact-render-to-string": "npm:preact-render-to-string@6.5.13"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
